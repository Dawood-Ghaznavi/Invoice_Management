{
  "name": "Invoice_Management",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/attachments": "^4.0.0",
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-invmanagement": "cds bind --exec --profile hybrid -- cds watch --open invmanagement/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy Invoice_Management --delete-services --delete-service-keys --delete-service-brokers",
    "hana": "cds deploy --to hana:Invoice_Management-db --auto-undeploy",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "CE_PURCHASEORDER_0001": {
        "kind": "odata",
        "model": "srv/external/CE_PURCHASEORDER_0001",
        "credentials": {
          "path": "/sap/opu/odata4/sap/api_purchaseorder_2/srvd_a2x/sap/purchaseorder/0001",
          "destination": "Business_Hub"
        }
      },
      "API_MATERIAL_DOCUMENT_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_MATERIAL_DOCUMENT_SRV",
        "credentials": {
          "path": "/sap/opu/odata/sap/API_MATERIAL_DOCUMENT_SRV",
          "destination": "Business_Hub"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/invmanagement"
  ]
}
