<mvc:View
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    controllerName="technicianassistant.ext.view.Main">
    <Page id="Main" showHeader="false" enableScrolling="false" class="technicianAssistantPage">
        <content>
            <HBox fitContainer="true" renderType="Bare" class="technicianShell">
                <VBox renderType="Bare" class="technicianSidebar">
                    <HBox alignItems="Center" renderType="Bare" class="jobRailHeading">
                        <Text text="{i18n>currentJobLabel}" class="jobRailTitle" />
                    </HBox>

                    <VBox visible="{view>/isSelectingJob}" renderType="Bare" class="jobSearchState">
                        <ComboBox
                            id="jobSelector"
                            width="100%"
                            selectedKey="{view>/selectedJobId}"
                            placeholder="{i18n>jobSelectorPlaceholder}"
                            showSecondaryValues="true"
                            filterSecondaryValues="true"
                            selectionChange=".onJobSelectionChange"
                            items="{
                                path: '/Jobs',
                                parameters: {
                                    $expand: 'equipment($expand=model)'
                                }
                            }">
                            <core:ListItem
                                key="{ID}"
                                text="{parts: ['jobNumber', 'equipment/name'], formatter: '.formatJobOption'}"
                                additionalText="{equipment/location}" />
                        </ComboBox>
                        <Button
                            visible="{view>/hasSelection}"
                            text="{i18n>cancelJobChange}"
                            type="Transparent"
                            press=".onCancelJobSelection"
                            class="cancelJobButton" />
                    </VBox>

                    <List
                        visible="{view>/showSelectedJob}"
                        showSeparators="None"
                        class="selectedJobList">
                        <CustomListItem type="Active" press=".onChangeJob" class="selectedJobItem">
                            <HBox alignItems="Center" renderType="Bare">
                                <HBox alignItems="Center" justifyContent="Center" renderType="Bare" class="selectedJobAvatar">
                                    <core:Icon src="sap-icon://wrench" decorative="true" class="selectedJobWrench" />
                                </HBox>
                                <VBox renderType="Bare" class="selectedJobText">
                                    <Title text="{jobNumber}" level="H3" class="selectedJobNumber" />
                                    <Text
                                        text="{equipment/name}"
                                        wrapping="false"
                                        class="selectedJobDescription" />
                                </VBox>
                                <core:Icon src="sap-icon://slim-arrow-down" decorative="true" class="changeJobIcon" />
                            </HBox>
                        </CustomListItem>
                    </List>

                    <VBox visible="{view>/hasSelection}" renderType="Bare" class="jobDetails">
                        <Title text="{i18n>jobDetailsLabel}" level="H4" class="sidebarSectionTitle" />
                        <VBox renderType="Bare" class="jobFacts">
                            <HBox renderType="Bare" class="jobFactRow">
                                <Label text="{i18n>locationLabel}" />
                                <Text text="{equipment/location}" wrapping="true" />
                            </HBox>
                            <HBox renderType="Bare" class="jobFactRow">
                                <Label text="{i18n>equipmentIdLabel}" />
                                <Text text="{equipment/equipmentID}" wrapping="true" />
                            </HBox>
                            <HBox renderType="Bare" class="jobFactRow">
                                <Label text="{i18n>modelLabel}" />
                                <Text text="{equipment/model/name}" wrapping="true" />
                            </HBox>
                            <HBox renderType="Bare" class="jobFactRow">
                                <Label text="{i18n>faultCodeLabel}" />
                                <Text text="{path: 'faultCode', formatter: '.formatOptionalValue'}" />
                            </HBox>
                            <HBox renderType="Bare" class="jobFactRow">
                                <Label text="{i18n>reportedAtLabel}" />
                                <Text text="{path: 'reportedAt', formatter: '.formatReportedAt'}" wrapping="true" />
                            </HBox>
                        </VBox>

                        <Title text="{i18n>reportedIssueLabel}" level="H4" class="sidebarSectionTitle reportedIssueTitle" />
                        <Text text="{operatorObservations}" wrapping="true" class="operatorReportText" />
                    </VBox>
                </VBox>

                <VBox fitContainer="true" renderType="Bare" class="technicianMain">
                    <layoutData>
                        <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0%" />
                    </layoutData>
                    <VBox renderType="Bare" class="technicianMainHeader">
                        <Title text="{i18n>MainTitle}" level="H1" class="technicianMainTitle" />
                    </VBox>

                    <VBox
                        visible="{view>/showSelectionPrompt}"
                        alignItems="Center"
                        justifyContent="Center"
                        renderType="Bare"
                        class="mainSelectionPrompt">
                        <Text
                            text="{path: 'view>/technicianIdentity', formatter: '.formatTechnicianGreeting'}"
                            visible="{= !!${view>/technicianIdentity} }"
                            class="chatEmptyGreeting" />
                        <Title text="{i18n>selectJobTitle}" level="H2" class="chatEmptyTitle" />
                    </VBox>

                    <VBox
                        visible="{view>/hasSelection}"
                        fitContainer="true"
                        renderType="Bare"
                        class="technicianChatArea">
                        <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0%" />
                        </layoutData>

                        <VBox
                            visible="{= !${view>/hasMessages} }"
                            fitContainer="true"
                            alignItems="Center"
                            justifyContent="Center"
                            renderType="Bare"
                            class="chatEmptyState">
                            <Text
                                text="{path: 'assignedTechnician', formatter: '.formatTechnicianGreeting'}"
                                visible="{= !!${assignedTechnician} }"
                                class="chatEmptyGreeting" />
                            <Title text="{i18n>chatEmptyTitle}" level="H2" class="chatEmptyTitle" />

                            <VBox width="100%" renderType="Bare" class="chatEmptyContent">
                                <HBox alignItems="End" renderType="Bare" class="chatComposer">
                                    <TextArea
                                        id="emptyMessageInput"
                                        value="{view>/activeConversation/draft}"
                                        valueLiveUpdate="true"
                                        enabled="{= !${view>/activeConversation/isLoading} }"
                                        growing="true"
                                        growingMaxLines="4"
                                        rows="1"
                                        width="100%"
                                        class="chatMessageInput"
                                        placeholder="{i18n>composerPlaceholder}">
                                        <layoutData>
                                            <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0%" />
                                        </layoutData>
                                    </TextArea>
                                    <Button
                                        icon="sap-icon://paper-plane"
                                        type="Emphasized"
                                        press=".onSend"
                                        enabled="{= !!${view>/activeConversation/draft} &amp;&amp; !${view>/activeConversation/isLoading} }"
                                        tooltip="{i18n>sendButtonTooltip}"
                                        class="chatSendButton" />
                                </HBox>
                            </VBox>
                        </VBox>

                        <ScrollContainer
                            id="messageScroller"
                            visible="{view>/hasMessages}"
                            width="100%"
                            height="100%"
                            horizontal="false"
                            vertical="true"
                            class="chatMessageScroller">
                            <layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0%" />
                            </layoutData>

                            <VBox width="100%" renderType="Bare" class="chatConversationColumn">
                                <List
                                    items="{view>/activeConversation/messages}"
                                    visible="{view>/hasMessages}"
                                    showNoData="false"
                                    showSeparators="None"
                                    class="chatMessageList">
                                    <CustomListItem class="chatMessageItem">
                                        <VBox renderType="Bare">
                                            <HBox
                                                visible="{= ${view>role} === 'user' }"
                                                justifyContent="End"
                                                renderType="Bare"
                                                class="chatUserMessageRow">
                                                <VBox renderType="Bare" class="chatUserMessage">
                                                    <Text text="{view>text}" renderWhitespace="true" wrapping="true" />
                                                </VBox>
                                            </HBox>

                                            <HBox
                                                visible="{= ${view>role} === 'assistant' }"
                                                alignItems="Start"
                                                renderType="Bare"
                                                class="chatAssistantMessageRow">
                                                <Avatar
                                                    displaySize="XS"
                                                    fallbackIcon="sap-icon://discussion-2"
                                                    class="chatAssistantAvatar" />
                                                <VBox width="100%" renderType="Bare" class="chatAssistantMessage">
                                                    <layoutData>
                                                        <FlexItemData growFactor="1" shrinkFactor="1" />
                                                    </layoutData>
                                                    <HBox
                                                        alignItems="Center"
                                                        renderType="Bare"
                                                        visible="{= !!${view>loading} }">
                                                        <BusyIndicator
                                                            size="1rem"
                                                            class="chatMessageBusy" />
                                                    </HBox>
                                                    <Text
                                                        visible="{= !${view>loading} &amp;&amp; !${view>error} }"
                                                        text="{view>text}"
                                                        renderWhitespace="true"
                                                        wrapping="true"
                                                        class="chatAssistantText" />
                                                    <ObjectStatus
                                                        visible="{= !${view>loading} &amp;&amp; !!${view>error} }"
                                                        text="{view>text}"
                                                        state="Error"
                                                        icon="sap-icon://message-error"
                                                        class="chatMessageError" />
                                                    <FlexBox
                                                        items="{view>citations}"
                                                        visible="{= ${view>citations}.length > 0 }"
                                                        wrap="Wrap"
                                                        alignItems="Center"
                                                        renderType="Bare"
                                                        class="chatCitations">
                                                        <Link
                                                            text="{path: 'view>pageNumber', formatter: '.formatCitationLabel'}"
                                                            tooltip="{parts: [{path: 'view>manualTitle'}, {path: 'view>manualVersion'}], formatter: '.formatCitationTooltip'}"
                                                            press=".onOpenCitation"
                                                            class="chatCitationLink" />
                                                    </FlexBox>
                                                </VBox>
                                            </HBox>
                                        </VBox>
                                    </CustomListItem>
                                </List>
                            </VBox>
                        </ScrollContainer>

                        <VBox
                            visible="{view>/hasMessages}"
                            renderType="Bare"
                            class="chatInputDock">
                            <HBox alignItems="End" renderType="Bare" class="chatComposer">
                                <TextArea
                                    id="messageInput"
                                    value="{view>/activeConversation/draft}"
                                    valueLiveUpdate="true"
                                    enabled="{= !${view>/activeConversation/isLoading} }"
                                    growing="true"
                                    growingMaxLines="4"
                                    rows="1"
                                    width="100%"
                                    class="chatMessageInput"
                                    placeholder="{i18n>composerPlaceholder}">
                                    <layoutData>
                                        <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0%" />
                                    </layoutData>
                                </TextArea>
                                <Button
                                    icon="sap-icon://paper-plane"
                                    type="Emphasized"
                                    press=".onSend"
                                    enabled="{= !!${view>/activeConversation/draft} &amp;&amp; !${view>/activeConversation/isLoading} }"
                                    tooltip="{i18n>sendButtonTooltip}"
                                    class="chatSendButton" />
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>
