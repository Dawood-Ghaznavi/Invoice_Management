{
  "_version": "1.86.0",
  "sap.app": {
    "id": "invmanagement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.10"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.30.0",
      "toolsId": "8d52ca9a-e2b0-479a-8803-c269e46c3fcf"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/invoice/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "invoice-manage": {
          "semanticObject": "invoice",
          "action": "manage",
          "title": "{{invoice-manage.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.layout": {},
        "sap.suite.ui.microchart": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "invmanagement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/AIRecommendation.css"
        }
      ]
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "invmanagement.ext.controller.AIRecommendation"
          }
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "InvoicesList",
          "target": "InvoicesList"
        },
        {
          "pattern": "Invoices({key}):?query:",
          "name": "InvoicesObjectPage",
          "target": "InvoicesObjectPage"
        }
      ],
      "targets": {
        "InvoicesList": {
          "type": "Component",
          "id": "InvoicesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Invoices",
              "variantManagement": "Page",
              "navigation": {
                "Invoices": {
                  "detail": {
                    "route": "InvoicesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "InvoicesObjectPage": {
          "type": "Component",
          "id": "InvoicesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Invoices",
              "controlConfiguration": {
                "attachments/@com.sap.vocabularies.UI.v1.LineItem": {
                  "actions": {
                    "ExtractInvoice": {
                      "text": "Extract",
                      "press": "invmanagement.ext.controller.AttachmentActions.extract",
                      "requiresSelection": false,
                      "visible": "{= %{IsActiveEntity} === false }",
                      "enabled": "{hasAttachments}",
                      "position": {
                        "placement": "After",
                        "anchor": "StandardAction::Create"
                      }
                    }
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "GenerateAIRecommendation": {
                      "text": "Generate AI Recommendation",
                      "press": "invmanagement.ext.controller.AttachmentActions.fetchRecommendation",
                      "visible": "{= %{processingType} === 'Non-PO' && %{status} === 'DRAFT' && %{IsActiveEntity} === false && (!%{suggestedGLAccount} || !%{suggestedCostCenter} || %{glAccount_code} !== %{suggestedGLAccount} || %{costCenter_code} !== %{suggestedCostCenter}) }",
                      "position": {
                        "placement": "After",
                        "anchor": "DataFieldForAction::InvoiceService.submit"
                      }
                    }
                  },
                  "facets": {
                    "StatusHeaderFacet": {
                      "template": "invmanagement.ext.StatusHeader",
                      "title": "Status",
                      "position": {
                        "placement": "After",
                        "anchor": "InvoiceNumberHeaderFacet"
                      }
                    },
                    "ProcessingTypeHeaderFacet": {
                      "template": "invmanagement.ext.InvoiceTypeHeader",
                      "title": "Processing Type",
                      "visible": "{= !!%{processingType} }",
                      "position": {
                        "placement": "After",
                        "anchor": "StatusHeaderFacet"
                      }
                    }
                  }
                },
                "body": {
                  "sections": {
                    "AIRecommendationCustomSection": {
                      "type": "XMLFragment",
                      "template": "invmanagement.ext.AIRecommendation",
                      "title": "Recommendation",
                      "position": {
                        "placement": "After",
                        "anchor": "AccountingAssignment"
                      },
                      "visible": "{= %{processingType} === 'Non-PO' && %{aiConfidence} !== null }"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "intinv"
  }
}
