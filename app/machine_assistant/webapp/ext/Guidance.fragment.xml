<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">
    <VBox class="guidanceExperience">
        <Title
            text="{= %{reportedConcern} || %{suggestedShortDescription} }"
            level="H4"
            titleStyle="H5"
            wrapping="true"
            class="guidanceContextLine" />

        <VBox
            visible="{reportedIssue>/hasGuidanceWarnings}"
            class="guidanceSafetySurface">
            <HBox alignItems="Center" class="guidanceSafetyHeader">
                <core:Icon
                    src="sap-icon://alert"
                    size="1.125rem"
                    class="guidanceSafetyIcon" />
                <Title
                    text="{i18n>manualWarningTitle}"
                    level="H4"
                    titleStyle="H5" />
            </HBox>
            <List
                items="{reportedIssue>/guidanceWarnings}"
                showSeparators="Inner"
                class="guidanceStatementList guidanceWarningList">
                <CustomListItem>
                    <HBox
                        alignItems="Start"
                        wrap="Wrap"
                        class="guidanceStatementRow">
                        <Text
                            text="{reportedIssue>text}"
                            wrapping="true"
                            class="guidanceStatementText">
                            <layoutData>
                                <FlexItemData growFactor="1" baseSize="22rem" />
                            </layoutData>
                        </Text>
                        <Link
                            text="{reportedIssue>citationLabel}"
                            tooltip="{reportedIssue>citationTooltip}"
                            visible="{= !!%{reportedIssue>sourceDocumentID} }"
                            press=".extension.machineassistant.ext.controller.ReportedIssue.onOpenGuidanceSource"
                            class="guidanceInlineCitation" />
                    </HBox>
                </CustomListItem>
            </List>
        </VBox>

        <layout:Grid
            defaultSpan="XL12 L12 M12 S12"
            hSpacing="1"
            vSpacing="0"
            class="guidanceResultGrid">
            <VBox class="suggestedReportPanel">
                <layoutData>
                    <layout:GridData span="XL7 L7 M12 S12" />
                </layoutData>
                <HBox alignItems="Center" class="suggestedReportHeader">
                    <core:Icon
                        src="sap-icon://document-text"
                        size="1.125rem"
                        class="suggestedReportIcon" />
                    <Title
                        text="{i18n>suggestedReportTitle}"
                        level="H4"
                        titleStyle="H4" />
                </HBox>

                <VBox class="suggestedReportField suggestedReportTitleField">
                    <Label
                        text="{i18n>suggestedShortDescriptionLabel}"
                        design="Bold" />
                    <Text
                        text="{suggestedShortDescription}"
                        wrapping="true"
                        class="suggestedShortDescription" />
                </VBox>

                <VBox class="suggestedReportField">
                    <Label
                        text="{i18n>suggestedDetailedDescriptionLabel}"
                        design="Bold" />
                    <Text
                        text="{suggestedDetailedDescription}"
                        wrapping="true"
                        class="suggestedDetailedDescription" />
                </VBox>

                <HBox
                    justifyContent="End"
                    alignItems="Center"
                    class="suggestedReportActions">
                    <Button
                        text="{i18n>useSuggestedReportButton}"
                        icon="sap-icon://accept"
                        type="Emphasized"
                        visible="{= !%{suggestionAdoptedAt} &amp;&amp; %{ui>/isEditable} }"
                        press=".extension.machineassistant.ext.controller.ReportedIssue.onUseSuggestedReport" />
                    <ObjectStatus
                        text="{i18n>suggestedReportUsedStatus}"
                        state="Success"
                        icon="sap-icon://sys-enter-2"
                        inverted="true"
                        visible="{= !!%{suggestionAdoptedAt} }" />
                </HBox>
            </VBox>

            <VBox class="guidanceActionsPanel">
                <layoutData>
                    <layout:GridData span="XL5 L5 M12 S12" />
                </layoutData>
                <Title
                    text="{i18n>additionalGuidanceTitle}"
                    level="H4"
                    titleStyle="H5" />
                <Text
                    text="{i18n>additionalGuidanceSubtitle}"
                    class="guidanceMutedText guidanceColumnIntro" />
                <List
                    items="{reportedIssue>/guidancePrimary}"
                    showSeparators="Inner"
                    visible="{reportedIssue>/hasGuidancePrimary}"
                    class="guidanceStatementList">
                    <CustomListItem>
                        <VBox class="guidanceActionItem">
                            <ObjectStatus
                                text="{reportedIssue>typeLabel}"
                                state="{reportedIssue>state}"
                                icon="{reportedIssue>icon}" />
                            <HBox
                                alignItems="Start"
                                wrap="Wrap"
                                class="guidanceStatementRow">
                                <Text
                                    text="{reportedIssue>text}"
                                    wrapping="true"
                                    class="guidanceStatementText">
                                    <layoutData>
                                        <FlexItemData growFactor="1" baseSize="13rem" />
                                    </layoutData>
                                </Text>
                                <Link
                                    text="{reportedIssue>citationLabel}"
                                    tooltip="{reportedIssue>citationTooltip}"
                                    visible="{= !!%{reportedIssue>sourceDocumentID} }"
                                    press=".extension.machineassistant.ext.controller.ReportedIssue.onOpenGuidanceSource"
                                    class="guidanceInlineCitation" />
                            </HBox>
                        </VBox>
                    </CustomListItem>
                </List>

                <Panel
                    headerText="{i18n>moreGuidanceTitle}"
                    expandable="true"
                    expanded="false"
                    backgroundDesign="Transparent"
                    visible="{reportedIssue>/hasGuidanceMore}"
                    class="guidanceMorePanel">
                    <List
                        items="{reportedIssue>/guidanceMore}"
                        showSeparators="Inner"
                        class="guidanceStatementList">
                        <CustomListItem>
                            <VBox class="guidanceActionItem">
                                <ObjectStatus
                                    text="{reportedIssue>typeLabel}"
                                    state="{reportedIssue>state}"
                                    icon="{reportedIssue>icon}" />
                                <HBox
                                    alignItems="Start"
                                    wrap="Wrap"
                                    class="guidanceStatementRow">
                                    <Text
                                        text="{reportedIssue>text}"
                                        wrapping="true"
                                        class="guidanceStatementText">
                                        <layoutData>
                                            <FlexItemData growFactor="1" baseSize="13rem" />
                                        </layoutData>
                                    </Text>
                                    <Link
                                        text="{reportedIssue>citationLabel}"
                                        tooltip="{reportedIssue>citationTooltip}"
                                        visible="{= !!%{reportedIssue>sourceDocumentID} }"
                                        press=".extension.machineassistant.ext.controller.ReportedIssue.onOpenGuidanceSource"
                                        class="guidanceInlineCitation" />
                                </HBox>
                            </VBox>
                        </CustomListItem>
                    </List>
                </Panel>

                <VBox
                    visible="{= !!%{missingInformation} }"
                    class="guidanceLimitation">
                    <ObjectStatus
                        text="{i18n>guidanceLimitationTitle}"
                        state="Information"
                        icon="sap-icon://message-information" />
                    <Text text="{missingInformation}" wrapping="true" />
                </VBox>
            </VBox>
        </layout:Grid>
    </VBox>
</core:FragmentDefinition>
