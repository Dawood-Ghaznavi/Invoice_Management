<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="predictionDialog"
        title="{i18n>predictionDialogTitle}"
        contentWidth="58rem"
        stretchOnPhone="true"
        busy="{prediction>/busy}"
        busyIndicatorDelay="0">
        <content>
            <VBox class="customerForecastPredictionContent">
                <MessageStrip
                    text="{i18n>predictionIntro}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

                <HBox
                    wrap="Wrap"
                    alignItems="End"
                    width="100%"
                    class="customerForecastPredictionFilters sapUiSmallMarginBottom">
                    <VBox width="14rem" class="sapUiTinyMarginBottom">
                        <Label
                            text="{i18n>predictionFromDate}"
                            labelFor="predictionFromDate" />
                        <DatePicker
                            id="predictionFromDate"
                            value="{prediction>/fromDate}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="medium"
                            initialFocusedDateValue="{prediction>/calendarFocusDate}"
                            width="100%" />
                    </VBox>
                    <VBox width="14rem" class="sapUiTinyMarginBottom">
                        <Label
                            text="{i18n>predictionToDate}"
                            labelFor="predictionToDate" />
                        <DatePicker
                            id="predictionToDate"
                            value="{prediction>/toDate}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="medium"
                            initialFocusedDateValue="{prediction>/calendarFocusDate}"
                            width="100%" />
                    </VBox>
                    <Button
                        text="{i18n>predictionRun}"
                        type="Emphasized"
                        press=".onRunPrediction"
                        class="sapUiTinyMarginBottom" />
                </HBox>

                <Text
                    text="{prediction>/contextSummary}"
                    visible="{prediction>/hasResults}"
                    class="customerForecastPredictionSummary sapUiSmallMarginBottom" />

                <Table
                    id="predictionResultsTable"
                    visible="{prediction>/hasResults}"
                    items="{prediction>/results}"
                    fixedLayout="true"
                    growing="true"
                    growingThreshold="12">
                    <columns>
                        <Column>
                            <Text text="{i18n>predictionDate}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>predictionDay}" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="{i18n>predictionActual}" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="{i18n>predictionPredicted}" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="{i18n>predictionAccuracy}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{prediction>visitDate}" />
                                <Text text="{prediction>dayOfWeek}" />
                                <ObjectNumber
                                    number="{prediction>actualVisitors}" />
                                <ObjectNumber
                                    number="{prediction>predictedVisitors}" />
                                <ObjectStatus
                                    text="{
                                        path: 'prediction>accuracy',
                                        formatter: '.formatAccuracy'
                                    }"
                                    state="{
                                        path: 'prediction>accuracy',
                                        formatter: '.formatAccuracyState'
                                    }" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <buttons>
            <Button
                text="{i18n>predictionClose}"
                press=".onClosePredictionDialog" />
            <Button
                text="{i18n>predictionSaveAndClose}"
                type="Emphasized"
                enabled="{prediction>/hasResults}"
                press=".onSavePredictions" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
